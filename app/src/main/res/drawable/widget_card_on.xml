<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/widget_button_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="0"
                android:endColor="@color/widget_card_on_end"
                android:startColor="@color/widget_card_on_start" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_card_stroke" />
        </shape>
    </item>
</ripple>
