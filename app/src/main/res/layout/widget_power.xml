<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_power_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_on"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="4dp"
    android:paddingBottom="6dp">

    <FrameLayout
        android:id="@+id/widget_power_circle"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/widget_circle_on">

        <ImageView
            android:id="@+id/widget_power_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_power_on" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="2dp">

        <TextView
            android:id="@+id/widget_power_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:letterSpacing="-0.01"
            android:maxLines="1"
            android:text="@string/widget_lights_on"
            android:textColor="@color/widget_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/widget_power_detail"
                style="@style/WidgetDetailText"
                android:text="@string/widget_brightness_preview" />

            <TextView
                android:id="@+id/widget_power_detail_error"
                style="@style/WidgetDetailText"
                android:text="@string/widget_brightness_preview"
                android:textColor="@color/widget_error_text"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_power_open"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/widget_button_bg"
        android:contentDescription="@string/widget_open_app">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_chevron" />
    </FrameLayout>
</LinearLayout>
