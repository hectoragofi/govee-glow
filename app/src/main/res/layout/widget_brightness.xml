<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_bright_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_on"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingTop="4dp"
    android:paddingEnd="6dp"
    android:paddingBottom="4dp">

    <FrameLayout
        android:id="@+id/widget_bright_down"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_button_bg"
        android:contentDescription="@string/widget_dim">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_minus" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/widget_bright_center"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/widget_bright_label"
                style="@style/WidgetLabelText"
                android:text="@string/widget_label_brightness" />

            <TextView
                android:id="@+id/widget_bright_label_accent"
                style="@style/WidgetLabelText"
                android:text="@string/widget_label_brightness"
                android:textColor="@color/widget_accent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_bright_label_error"
                style="@style/WidgetLabelText"
                android:text="@string/widget_label_brightness"
                android:textColor="@color/widget_error_text"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/widget_bright_value"
                    style="@style/WidgetValueText"
                    android:text="80%" />

                <TextView
                    android:id="@+id/widget_bright_value_muted"
                    style="@style/WidgetValueText"
                    android:text="80%"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="16sp"
                    android:visibility="gone" />
            </FrameLayout>

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="1dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_chevron" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/widget_bright_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="3dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="80"
            android:progressDrawable="@drawable/widget_progress" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_bright_up"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_button_bg"
        android:contentDescription="@string/widget_brighten">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_plus" />
    </FrameLayout>
</LinearLayout>
